<Window x:Class="CustomFences.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrbitDock Settings"
        Width="1160"
        Height="640"
        MinWidth="980"
        MinHeight="540"
        Background="#0E1117"
        Icon="Assets/Brand/OrbitDock.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EEF8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,14" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#151B25" />
            <Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="BorderBrush" Value="#2C3748" />
            <Setter Property="CaretBrush" Value="#F7FAFF" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,10" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#151B25" />
            <Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="BorderBrush" Value="#2C3748" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#202A38" />
            <Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="BorderBrush" Value="#39475B" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EEF8" />
            <Setter Property="Margin" Value="0,0,18,8" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#283448" BorderThickness="1" Background="#0E1117">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#151B25" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="OrbitDock Settings"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#B9C7D8" />
                    <Button Content="X"
                            FontFamily="Segoe UI Semibold"
                            FontSize="12"
                            Foreground="#E8EEF8"
                            HorizontalAlignment="Right"
                            Width="42"
                            Height="38"
                            Margin="0"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Click="Close_Click"
                            ToolTip="Close" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#111821" BorderBrush="#253043" BorderThickness="0,0,1,0">
                    <Grid Margin="22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Assets/Brand/OrbitDock-64.png"
                                       Width="40"
                                       Height="40"
                                       Margin="0,0,12,0" />
                                <TextBlock Text="OrbitDock"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="28"
                                           VerticalAlignment="Center"
                                           Foreground="#FFFFFF" />
                            </StackPanel>
                            <TextBlock Text="Desktop launchpads"
                                       Foreground="#8EA1B8"
                                       Margin="0,6,0,18" />
                            <TextBlock Text="Active layout" FontFamily="Segoe UI Semibold" FontSize="13" />
                            <ComboBox x:Name="LayoutsComboBox"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="LayoutsComboBox_SelectionChanged" />
                            <TextBox x:Name="LayoutNameTextBox" Margin="0,0,0,10" />
                            <WrapPanel Margin="0,0,0,18">
                                <Button Content="Save Layout" Click="SaveLayout_Click" Margin="0,0,8,8" />
                                <Button Content="Switch" Click="SwitchLayout_Click" Margin="0,0,8,8" />
                                <Button Content="Duplicate" Click="DuplicateLayout_Click" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 x:Name="ZonesList"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="ZonesList_SelectionChanged"
                                 Background="Transparent"
                                 BorderBrush="#2C3748"
                                 Foreground="#F7FAFF" />

                        <StackPanel Grid.Row="2">
                            <Button Content="Add Zone" Click="AddZone_Click" Margin="0,14,0,8" />
                            <Button Content="Open Workspace JSON" Click="OpenWorkspace_Click" Margin="0,0,0,8" />
                            <Button Content="Repair Dock Sizes" Click="RepairDockSizes_Click" Margin="0,0,0,8" />
                            <Button Content="Reload" Click="Reload_Click" Margin="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="28" Width="540" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Zone Details" FontFamily="Segoe UI Semibold" FontSize="22" />
                                <TextBlock Text="Save changes into the per-user workspace file and reload the desktop zones."
                                           Foreground="#8EA1B8"
                                           Margin="0,5,0,22" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Close"
                                    Click="Close_Click"
                                    VerticalAlignment="Top"
                                    Margin="12,0,0,0" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Name" />
                                <TextBox x:Name="NameTextBox" />

                                <TextBlock Text="Primary folder portal" />
                                <TextBox x:Name="PathTextBox" />

                                <TextBlock Text="Accent color" />
                                <TextBox x:Name="AccentTextBox" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Background color" />
                                <TextBox x:Name="BackgroundTextBox" />

                                <TextBlock Text="Opacity" />
                                <TextBox x:Name="OpacityTextBox" />

                                <TextBlock Text="Icon size" />
                                <TextBox x:Name="IconSizeTextBox" />

                                <TextBlock Text="Expansion edge" />
                                <ComboBox x:Name="ExpansionEdgeComboBox" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <WrapPanel Margin="0,0,0,10">
                                <CheckBox x:Name="VisibleCheckBox" Content="Visible" />
                                <CheckBox x:Name="LockedCheckBox" Content="Locked" />
                                <CheckBox x:Name="CollapsedCheckBox" Content="Rolled up" />
                                <CheckBox x:Name="AttachDesktopCheckBox" Content="Desktop attach" ToolTip="Best-effort shell attachment; disable if it misbehaves." />
                                <CheckBox x:Name="CleanDesktopCheckBox" Content="Clean desktop" ToolTip="Hide the raw Windows desktop icon grid while OrbitDock is running." />
                                <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows" ToolTip="Adds or removes OrbitDock from your Windows startup apps." />
                                <CheckBox x:Name="SoundEffectsCheckBox" Content="Sound effects" />
                                <CheckBox x:Name="MusicDockCheckBox" Content="Music dock" />
                            </WrapPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sound effects volume" />
                                    <TextBox x:Name="SoundEffectsVolumeTextBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Music folder" />
                                    <TextBox x:Name="MusicFolderTextBox" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel>
                                <Button Content="Save Zone" Click="SaveZone_Click" />
                                <Button Content="Restore Size" Click="RestoreDockSize_Click" />
                                <Button Content="Duplicate Zone" Click="DuplicateZone_Click" />
                                <Button Content="Delete Zone" Click="DeleteZone_Click" />
                                <Button Content="Open Music Folder" Click="OpenMusicFolder_Click" />
                            </WrapPanel>

                            <Border Background="#121821"
                                    BorderBrush="#273448"
                                    BorderThickness="1"
                                    Padding="16"
                                    Margin="0,24,0,0"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="Safety Defaults" FontFamily="Segoe UI Semibold" FontSize="15" />
                                    <TextBlock Text="Dropped items are copied unless you change defaultDropAction in the workspace JSON. Rule automation is stored but disabled until explicitly enabled."
                                               TextWrapping="Wrap"
                                               Foreground="#AFC0D4"
                                               Margin="0,7,0,0" />
                                    <TextBlock x:Name="StatusText"
                                               Foreground="#7DDDBF"
                                               Margin="0,13,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
