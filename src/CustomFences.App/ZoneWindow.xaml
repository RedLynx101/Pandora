<Window x:Class="CustomFences.App.ZoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrbitDock Zone"
        Width="360"
        Height="300"
        MinWidth="230"
        MinHeight="76"
        Icon="Assets/Brand/OrbitDock.ico"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Deactivated="Window_Deactivated"
        LocationChanged="Window_PlacementChanged"
        SizeChanged="Window_PlacementChanged"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Border x:Name="Frame"
            Background="{Binding BackgroundBrush}"
            BorderBrush="{Binding BorderBrush}"
            BorderThickness="1"
            CornerRadius="{Binding CornerRadius}"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding HeaderHeight}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{Binding HeaderBrush}"
                    CornerRadius="17,17,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="13,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="30"
                            Height="30"
                            CornerRadius="10"
                            Background="#22FFFFFF"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <Image Source="Assets/Brand/OrbitDock-32.png"
                               Width="22"
                               Height="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="#F7FAFF"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="15"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE72C;"
                                ToolTip="Refresh"
                                Click="Refresh_Click" />
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE70D;"
                                ToolTip="Open folder"
                                Margin="6,0,0,0"
                                Click="OpenFolder_Click" />
                        <Button x:Name="CollapseButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE96E;"
                                ToolTip="Roll up"
                                Margin="6,0,0,0"
                                Click="Collapse_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ListBox Grid.Row="1"
                     x:Name="ItemsList"
                     ItemsSource="{Binding Items}"
                     Background="Transparent"
                     BorderThickness="0"
                     AllowDrop="True"
                     SelectionMode="Single"
                     Focusable="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="ItemsList_MouseDoubleClick"
                     PreviewKeyDown="ItemsList_PreviewKeyDown"
                     PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ItemsList_PreviewMouseMove"
                     PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown"
                     DragOver="ItemsList_DragOver"
                     Drop="ItemsList_Drop">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" Margin="10,10,8,6" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemChrome"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            Padding="7">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="#24FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="#22FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:FileItemViewModel}" xmlns:local="clr-namespace:CustomFences.App">
                        <Grid Width="{Binding DataContext.ItemWidth, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <Image Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   Source="{Binding Icon}"
                                   HorizontalAlignment="Center"
                                   SnapsToDevicePixels="True" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding DisplayName}"
                                       Foreground="#E8EEF8"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       LineHeight="13" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="OpenItem_Click" />
                        <MenuItem Header="Remove from Dock" Click="RemoveFromDock_Click" />
                        <MenuItem Header="Pin to Desktop" Click="PinToDesktop_Click" />
                        <MenuItem Header="Reveal in Explorer" Click="RevealItem_Click" />
                        <Separator />
                        <MenuItem Header="Delete Real File..." Click="DeleteRealFile_Click" />
                        <Separator />
                        <MenuItem Header="Refresh" Click="Refresh_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <Border Grid.Row="2" Background="#14000000" CornerRadius="0,0,17,17">
                <DockPanel Margin="12,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#AFC0D4"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
