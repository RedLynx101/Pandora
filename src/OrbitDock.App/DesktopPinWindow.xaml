<Window x:Class="OrbitDock.App.DesktopPinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrbitDock Desktop Pin"
        Width="98"
        Height="92"
        MinWidth="72"
        MinHeight="72"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Icon="Assets/Brand/OrbitDock.ico"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Deactivated="Window_Deactivated"
        LocationChanged="Window_PlacementChanged">
    <Border x:Name="Frame"
            Background="#22080E16"
            BorderBrush="#3456D6FF"
            BorderThickness="1"
            CornerRadius="12"
            Padding="7"
            MouseLeftButtonDown="Frame_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="5" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Image x:Name="PinIcon"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   SnapsToDevicePixels="True" />
            <TextBlock x:Name="PinName"
                       Grid.Row="1"
                       Foreground="#F0F5FF"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       LineHeight="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,5,0,0" />
        </Grid>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open" Click="Open_Click" />
                <MenuItem Header="Send to a Dock" Click="SendToDock_Click" />
                <MenuItem Header="Reveal in Explorer" Click="Reveal_Click" />
                <Separator />
                <MenuItem Header="Remove from Desktop" Click="Remove_Click" />
            </ContextMenu>
        </Border.ContextMenu>
    </Border>
</Window>
