<Window x:Class="OrbitDock.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="OrbitDock Settings"
        Width="1180"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        Background="#090D14"
        Icon="Assets/Brand/OrbitDock.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF2FF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#94A8BE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#BFD0E3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#111923" />
            <Setter Property="Foreground" Value="#F8FBFF" />
            <Setter Property="BorderBrush" Value="#314158" />
            <Setter Property="CaretBrush" Value="#F8FBFF" />
            <Setter Property="SelectionBrush" Value="#556EDBFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#1C2735" />
            <Setter Property="Foreground" Value="#F8FBFF" />
            <Setter Property="BorderBrush" Value="#3A4B63" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#26364A" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#52708F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#32465E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#718196" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#121923" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#243143" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#245F7B" />
            <Setter Property="BorderBrush" Value="#52BEEB" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3A1D26" />
            <Setter Property="BorderBrush" Value="#8A4053" />
            <Setter Property="Foreground" Value="#FFE7EE" />
        </Style>

        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDE9F8" />
            <Setter Property="Margin" Value="0,0,18,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0D141D" />
            <Setter Property="Foreground" Value="#EEF6FF" />
            <Setter Property="BorderBrush" Value="#29394E" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="#EEF6FF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#182332" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#244760" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="#66C9F4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2D3C51" BorderThickness="1,0,1,1" Background="#090D14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#111923" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="Assets/Brand/OrbitDock-32.png"
                               Width="24"
                               Height="24"
                               Margin="0,0,10,0" />
                        <TextBlock Text="OrbitDock Settings"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="14"
                                   Foreground="#F2F7FF" />
                        <TextBlock Text="Workspace control center"
                                   Style="{StaticResource MutedText}"
                                   Margin="14,1,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Foreground="#EAF2FF"
                            HorizontalAlignment="Right"
                            Width="46"
                            Height="46"
                            Margin="0"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Click="Close_Click"
                            ToolTip="Close" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#0D141D"
                        BorderBrush="#26364B"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Active Layout"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,6" />
                            <ComboBox x:Name="LayoutsComboBox"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="LayoutsComboBox_SelectionChanged"
                                      Margin="0,0,0,8" />
                            <TextBox x:Name="LayoutNameTextBox" Margin="0,0,0,10" />
                            <UniformGrid Columns="4" Margin="0,0,0,14">
                                <Button Content="Save" Click="SaveLayout_Click" Style="{StaticResource AccentButton}" MinWidth="0" />
                                <Button Content="Switch" Click="SwitchLayout_Click" Style="{StaticResource SidebarButton}" />
                                <Button Content="Copy" Click="DuplicateLayout_Click" Style="{StaticResource SidebarButton}" />
                                <Button x:Name="DeleteLayoutButton"
                                        Content="Delete"
                                        Click="DeleteLayout_Click"
                                        Style="{StaticResource DangerButton}"
                                        MinWidth="0" />
                            </UniformGrid>

                            <UniformGrid Columns="2" Margin="0,0,0,16">
                                <Button Content="Add Zone" Click="AddZone_Click" Style="{StaticResource AccentButton}" />
                                <Button Content="Workspace JSON" Click="OpenWorkspace_Click" Style="{StaticResource SidebarButton}" />
                                <Button Content="Repair Sizes" Click="RepairDockSizes_Click" Style="{StaticResource SidebarButton}" />
                                <Button Content="Reload" Click="Reload_Click" Style="{StaticResource SidebarButton}" />
                            </UniformGrid>

                            <TextBlock Text="Zones"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,8" />
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 x:Name="ZonesList"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="ZonesList_SelectionChanged" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,30,34,26" MaxWidth="760">
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Zone Details"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="26"
                                           Foreground="#F8FBFF" />
                                <TextBlock Text="Edit the selected dock, then save to update the local workspace and running desktop."
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#102233"
                                    BorderBrush="#2B5E78"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="10,6"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="StatusText"
                                           Text="Ready"
                                           Foreground="#85E6C2"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="260" />
                            </Border>
                        </Grid>

                        <Border BorderBrush="#26364B"
                                BorderThickness="0,1,0,0"
                                Padding="0,22,0,0">
                            <StackPanel>
                                <TextBlock Text="Identity" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="NameTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Primary folder portal" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="PathTextBox" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#26364B"
                                BorderThickness="0,1,0,0"
                                Padding="0,22,0,0"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Background color" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="BackgroundTextBox" />
                                        <TextBlock Text="Accent color" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="AccentTextBox" />
                                        <TextBlock Text="Expansion edge" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ExpansionEdgeComboBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="OpacityTextBox" />
                                        <TextBlock Text="Icon size" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="IconSizeTextBox" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#26364B"
                                BorderThickness="0,1,0,0"
                                Padding="0,22,0,0"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Behavior" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <CheckBox x:Name="VisibleCheckBox" Content="Visible" />
                                    <CheckBox x:Name="LockedCheckBox" Content="Locked" />
                                    <CheckBox x:Name="CollapsedCheckBox" Content="Rolled up" />
                                    <CheckBox x:Name="AttachDesktopCheckBox"
                                              Content="Desktop attach"
                                              ToolTip="Best-effort shell attachment; disable if it misbehaves." />
                                    <CheckBox x:Name="CleanDesktopCheckBox"
                                              Content="Clean desktop"
                                              ToolTip="Hide the raw Windows desktop icon grid while OrbitDock is running." />
                                    <CheckBox x:Name="StayVisibleOnShowDesktopCheckBox"
                                              Content="Stay on desktop"
                                              ToolTip="Keep docks visible when Windows shows the desktop." />
                                    <CheckBox x:Name="StartWithWindowsCheckBox"
                                              Content="Start with Windows"
                                              ToolTip="Adds or removes OrbitDock from your Windows startup apps."
                                              Click="StartWithWindows_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#26364B"
                                BorderThickness="0,1,0,0"
                                Padding="0,22,0,0"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Audio" Style="{StaticResource SectionTitle}" />
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="SoundEffectsCheckBox" Content="Sound effects" />
                                    <CheckBox x:Name="MusicDockCheckBox" Content="Music dock" />
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Sound effects volume" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SoundEffectsVolumeTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Music folder" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="MusicFolderTextBox" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="Open Music Folder"
                                        Click="OpenMusicFolder_Click"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#26364B"
                                BorderThickness="0,1,0,0"
                                Padding="0,22,0,0"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Zone Actions" Style="{StaticResource SectionTitle}" />
                                <UniformGrid Columns="5">
                                    <Button x:Name="SaveZoneButton"
                                            Content="Save Zone"
                                            Click="SaveZone_Click"
                                            Style="{StaticResource AccentButton}" />
                                    <Button x:Name="CenterZoneButton"
                                            Content="Center Zone"
                                            Click="CenterZone_Click" />
                                    <Button x:Name="RestoreSizeButton"
                                            Content="Restore Size"
                                            Click="RestoreDockSize_Click" />
                                    <Button x:Name="DuplicateZoneButton"
                                            Content="Duplicate Zone"
                                            Click="DuplicateZone_Click" />
                                    <Button x:Name="DeleteZoneButton"
                                            Content="Delete Zone"
                                            Click="DeleteZone_Click"
                                            Style="{StaticResource DangerButton}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="#0D141D"
                                BorderBrush="#26364B"
                                BorderThickness="1"
                                Padding="16"
                                Margin="0,22,0,0"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Safety Defaults"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="15" />
                                <TextBlock Text="Default organization is virtual. Removing a dock item does not delete the real file unless you explicitly choose the delete-real-file action."
                                           Style="{StaticResource MutedText}"
                                           Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
