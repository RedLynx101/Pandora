<Window x:Class="OrbitDock.App.ZoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrbitDock.App"
        Title="OrbitDock Zone"
        Width="360"
        Height="300"
        MinWidth="230"
        MinHeight="76"
        Icon="Assets/Brand/OrbitDock.ico"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Deactivated="Window_Deactivated"
        StateChanged="Window_StateChanged"
        LocationChanged="Window_PlacementChanged"
        SizeChanged="Window_PlacementChanged"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Border x:Name="Frame"
            Background="{Binding BackgroundBrush}"
            BorderBrush="{Binding BorderBrush}"
            BorderThickness="1"
            CornerRadius="{Binding CornerRadius}"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopChromeRow" Height="{Binding HeaderHeight}" />
                <RowDefinition x:Name="ContentRow" Height="*" />
                <RowDefinition x:Name="BottomChromeRow" Height="26" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBorder"
                    Grid.Row="0"
                    Background="{Binding HeaderBrush}"
                    CornerRadius="17,17,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid x:Name="HeaderGrid" Margin="13,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="30"
                            Height="30"
                            CornerRadius="10"
                            Background="#22FFFFFF"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <Image Source="Assets/Brand/OrbitDock-32.png"
                               Width="22"
                               Height="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <StackPanel x:Name="TitleStackPanel" Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel x:Name="DockTitlePanel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#F7FAFF"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="15"
                                           TextTrimming="CharacterEllipsis" />
                                <Border x:Name="AgentBadgeBorder"
                                        Margin="8,0,0,0"
                                        Padding="7,1"
                                        CornerRadius="8"
                                        Background="#CC8BE9C7"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AgentFeedBadgeText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding AgentFeedBadgeText}"
                                               Foreground="#061016"
                                               FontFamily="Segoe UI Semibold"
                                               FontSize="10" />
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBox x:Name="SearchBox"
                                 Visibility="Collapsed"
                                 Height="26"
                                 Margin="0,0,10,0"
                                 Padding="9,3"
                                 Background="#1EFFFFFF"
                                 Foreground="#F7FAFF"
                                 BorderBrush="#557DDCFF"
                                 CaretBrush="#F7FAFF"
                                 FontFamily="Segoe UI"
                                 FontSize="12"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    </StackPanel>

                    <StackPanel x:Name="HeaderButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="MusicHeaderControls"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed"
                                    Margin="0,0,6,0">
                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE892;"
                                    ToolTip="Previous"
                                    Click="MusicPrevious_Click" />
                            <Button x:Name="MusicPlayPauseButton"
                                    Style="{StaticResource IconButton}"
                                    Content="{Binding PlayPauseGlyph}"
                                    ToolTip="Play or pause"
                                    Margin="6,0,0,0"
                                    Click="MusicPlayPause_Click" />
                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE893;"
                                    ToolTip="Next"
                                    Margin="6,0,0,0"
                                    Click="MusicNext_Click" />
                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE74F;"
                                    ToolTip="Mute"
                                    Margin="6,0,0,0"
                                    Click="MusicMute_Click" />
                        </StackPanel>
                        <Button x:Name="SearchButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE721;"
                                ToolTip="Search this dock"
                                Click="Search_Click" />
                        <Button Style="{StaticResource IconButton}"
                                Content="&#xE72C;"
                                ToolTip="Refresh"
                                Margin="6,0,0,0"
                                Click="Refresh_Click" />
                        <Button x:Name="OpenExplorerButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE8B7;"
                                ToolTip="Open in Explorer"
                                Margin="6,0,0,0"
                                Click="OpenFolder_Click" />
                        <Button x:Name="CollapseButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE96E;"
                                ToolTip="Roll up"
                                Margin="6,0,0,0"
                                Click="Collapse_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="ContentHost">
            <ListBox
                     x:Name="ItemsList"
                     ItemsSource="{Binding Items}"
                     Background="Transparent"
                     BorderThickness="0"
                     AllowDrop="True"
                     SelectionMode="Single"
                     Focusable="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="ItemsList_MouseDoubleClick"
                     PreviewKeyDown="ItemsList_PreviewKeyDown"
                     PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ItemsList_PreviewMouseMove"
                     PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown"
                     DragOver="ItemsList_DragOver"
                     Drop="ItemsList_Drop">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" Margin="10,10,8,6" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemChrome"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            Padding="7">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="#24FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="#22FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:FileItemViewModel}">
                        <Grid Width="{Binding DataContext.ItemWidth, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <Image Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   Source="{Binding Icon}"
                                   HorizontalAlignment="Center"
                                   SnapsToDevicePixels="True" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding DisplayName}"
                                       Foreground="#E8EEF8"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       LineHeight="13" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="OpenItem_Click" />
                        <MenuItem Header="Remove from Dock" Click="RemoveFromDock_Click" />
                        <MenuItem Header="Pin to Desktop" Click="PinToDesktop_Click" />
                        <MenuItem Header="Reveal in Explorer" Click="RevealItem_Click" />
                        <Separator />
                        <MenuItem Header="Move Real File to Recycle Bin..." Click="DeleteRealFile_Click" />
                        <Separator />
                        <MenuItem Header="Refresh" Click="Refresh_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <Grid x:Name="MusicPanel"
                  Visibility="Collapsed"
                  Margin="14,12,14,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding NowPlayingText}"
                                   Foreground="#F7FAFF"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Orbit Radio"
                                   Foreground="#90A6BA"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="160"
                              ItemsSource="{Binding MusicPlaylists}"
                              SelectedItem="{Binding SelectedMusicPlaylist, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Background="#151B25"
                              Foreground="#F7FAFF"
                              BorderBrush="#33465B" />
                </Grid>

                <ListBox Grid.Row="1"
                         x:Name="MusicTracksList"
                         ItemsSource="{Binding MusicTracks}"
                         SelectedItem="{Binding SelectedMusicTrack, Mode=TwoWay}"
                         Background="#14000000"
                         BorderThickness="0"
                         Foreground="#F7FAFF"
                         Margin="0,12,0,10"
                         MouseDoubleClick="MusicTracksList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MusicTrackViewModel}">
                            <TextBlock Text="{Binding Title}"
                                       Padding="9,5"
                                       Foreground="#E8EEF8"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ShuffleCheckBox"
                              Content="Shuffle"
                              Foreground="#DCE8F5"
                              IsChecked="{Binding IsMusicShuffle, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              x:Name="RepeatComboBox"
                              Width="88"
                              Margin="12,0"
                              SelectionChanged="RepeatComboBox_SelectionChanged" />
                    <Slider Grid.Column="2"
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding MusicVolume, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                    <Button Grid.Column="3"
                            Content="Open Music Folder"
                            Padding="10,5"
                            Background="#202A38"
                            Foreground="#F7FAFF"
                            BorderBrush="#39475B"
                            Click="OpenMusicFolder_Click" />
                </Grid>
            </Grid>

            <Grid x:Name="AgentFeedPanel"
                  Visibility="Collapsed"
                  Margin="14,12,14,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding AgentFeedTitle}"
                                   Foreground="#F7FAFF"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="15"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Border Padding="7,2"
                                    CornerRadius="8"
                                    Background="#228BE9C7"
                                    BorderBrush="#668BE9C7"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding AgentFeedStatusText}"
                                           Foreground="#DFFDF4"
                                           FontSize="10"
                                           FontFamily="Segoe UI Semibold" />
                            </Border>
                            <TextBlock Text="{Binding AgentFeedSourceLine}"
                                       Foreground="#8EA3B8"
                                       FontSize="11"
                                       Margin="8,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              x:Name="AgentFeedSelector"
                              Width="150"
                              ItemsSource="{Binding AgentFeeds}"
                              SelectedItem="{Binding SelectedAgentFeed, Mode=TwoWay}"
                              DisplayMemberPath="Title"
                              SelectionChanged="AgentFeedSelector_SelectionChanged" />
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,12,0,10"
                        Padding="11,9"
                        CornerRadius="8"
                        Background="#1AFFFFFF"
                        BorderBrush="#338BE9C7"
                        BorderThickness="1">
                    <TextBlock Text="{Binding AgentFeedSummary}"
                               Foreground="#EAF3FF"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedAgentFeed.Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AgentFeedSectionViewModel}">
                                <Border Margin="0,0,0,10"
                                        Padding="11,9"
                                        CornerRadius="8"
                                        Background="#12000000"
                                        BorderBrush="#263C4F"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#F7FAFF"
                                                   FontFamily="Segoe UI Semibold"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="#C8D7E8"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                        <ItemsControl ItemsSource="{Binding ChecklistItems}" Margin="0,7,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:AgentFeedChecklistItemViewModel}">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Foreground="#EAF3FF"
                                                              Margin="0,0,0,7">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Text}"
                                                                       Foreground="#EAF3FF"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Foreground="#8EA3B8"
                                                                       FontSize="10"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,7,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:AgentFeedTextItemViewModel}">
                                                    <StackPanel Margin="0,0,0,7">
                                                        <TextBlock Text="{Binding Text}"
                                                                   Foreground="#EAF3FF"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Foreground="#8EA3B8"
                                                                   FontSize="10"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            </Grid>

            <Border x:Name="StatusBorder" Grid.Row="2" Background="#14000000" CornerRadius="0,0,17,17">
                <DockPanel Margin="12,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#AFC0D4"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
