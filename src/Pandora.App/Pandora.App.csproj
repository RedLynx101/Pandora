<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Content Include="..\..\tools\SilkCurrentVisualizer\index.html;..\..\tools\SilkCurrentVisualizer\styles.css;..\..\tools\SilkCurrentVisualizer\start-visualizer.ps1">
      <Link>tools\SilkCurrentVisualizer\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\tools\SilkCurrentVisualizer\src\visualizer.js">
      <Link>tools\SilkCurrentVisualizer\src\visualizer.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <ProjectReference Include="..\Pandora.Core\Pandora.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Pandora.App</AssemblyName>
    <Product>Pandora</Product>
    <Title>Pandora</Title>
    <Description>Celestial desktop docks and grounded project visibility.</Description>
    <ApplicationIcon>Assets\Brand\Pandora.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Brand\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
