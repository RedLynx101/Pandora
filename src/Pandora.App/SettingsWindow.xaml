<Window x:Class="Pandora.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Pandora.App"
        Title="Pandora — Settings" Width="1080" Height="760" MinWidth="860" MinHeight="620"
        Background="{DynamicResource Pandora.WindowBrush}" Foreground="{DynamicResource Pandora.TextBrush}" FontFamily="Segoe UI"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource Pandora.MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="19" /></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontFamily" Value="Segoe UI Semibold" /><Setter Property="FontSize" Value="15" /><Setter Property="Margin" Value="0,24,0,12" /></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,0,0,7" /></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,0,0,16" /></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,0,0,16" /></Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,8,8" /></Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0,0,16,10" /></Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{DynamicResource Pandora.DangerBrush}" /></Style>
        <Style x:Key="DockThemeChoice" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Foreground" Value="{DynamicResource Pandora.TextBrush}" /><Setter Property="FocusVisualStyle" Value="{StaticResource Pandora.FocusVisual}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="ChoiceBorder" Background="{DynamicResource Pandora.SurfaceBrush}" BorderBrush="{DynamicResource Pandora.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource Pandora.AccentBrush}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource Pandora.AccentBrush}" /><Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="2" /><Setter TargetName="ChoiceBorder" Property="Padding" Value="7" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OptionalAppearanceSection" TargetType="Expander">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource Pandora.TextBrush}" FocusVisualStyle="{StaticResource Pandora.FocusVisual}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="HeaderSurface" Background="Transparent" BorderBrush="{DynamicResource Pandora.BorderBrush}" BorderThickness="0,0,0,1" Padding="0,5,0,9">
                                <DockPanel><TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Pandora.MutedBrush}" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,4,0" /><ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" /></DockPanel>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource Pandora.AccentBrush}" /></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" /></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" />
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Pandora.WindowBrush}" TextElement.Foreground="{DynamicResource Pandora.TextBrush}" BorderBrush="{DynamicResource Pandora.BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="*" /><RowDefinition Height="54" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource Pandora.SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Image x:Name="BrandImage" Width="26" Height="26" Margin="0,0,10,0" />
                        <TextBlock Text="Pandora" FontSize="16" FontFamily="Segoe UI Semibold" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" Foreground="{DynamicResource Pandora.MutedBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE921;" Style="{StaticResource IconButton}" Width="44" Height="48" ToolTip="Minimize" AutomationProperties.Name="Minimize settings" Click="Minimize_Click" />
                        <Button Content="&#xE922;" Style="{StaticResource IconButton}" Width="44" Height="48" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore settings" Click="Maximize_Click" />
                        <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" Width="48" Height="48" ToolTip="Close" AutomationProperties.Name="Close settings" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="192" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Pandora.SurfaceBrush}" BorderBrush="{DynamicResource Pandora.BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="12,20,12,18">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ListBox x:Name="SettingsNavigation" SelectionChanged="SettingsNavigation_SelectionChanged" AutomationProperties.Name="Settings categories">
                            <ListBoxItem Tag="Appearance" Content="Appearance" /><ListBoxItem Tag="Desktop" Content="Desktop" /><ListBoxItem Tag="Docks" Content="Docks" /><ListBoxItem Tag="Layouts" Content="Layouts" /><ListBoxItem Tag="Audio" Content="Audio" /><ListBoxItem Tag="About" Content="About" />
                        </ListBox>
                        <TextBlock Grid.Row="1" Text="Your workspace.&#x0a;Stored on this device." Style="{StaticResource MutedText}" Margin="12,0,0,0" />
                    </Grid>
                </Border>
                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="32,26,32,24">
                        <TextBlock x:Name="PageTitle" Text="Appearance" FontSize="27" FontFamily="Segoe UI Semibold" Margin="0,0,0,7" />
                        <TextBlock x:Name="PageDescription" Style="{StaticResource MutedText}" Margin="0,0,0,18" />
                        <StackPanel x:Name="AppearancePanel" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" MaxWidth="900">
                            <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" />
                            <ListBox x:Name="DockThemeListBox" SelectionChanged="Appearance_SelectionChanged" ItemContainerStyle="{StaticResource DockThemeChoice}" Margin="0,0,-8,16" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Dock structural theme">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBoxItem Tag="Classic" AutomationProperties.Name="Classic — rounded, familiar">
                                    <StackPanel><local:DockThemePreviewControl x:Name="ClassicPreview" DockTheme="Classic" Height="94" IsHitTestVisible="False" /><TextBlock Text="Classic" FontFamily="Segoe UI Semibold" Margin="5,8,5,2" /><TextBlock Text="Rounded · familiar" Style="{StaticResource MutedText}" Margin="5,0,5,3" /></StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="Halo" AutomationProperties.Name="Halo — floating, airy">
                                    <StackPanel><local:DockThemePreviewControl x:Name="HaloPreview" DockTheme="Halo" Height="94" IsHitTestVisible="False" /><TextBlock Text="Halo" FontFamily="Segoe UI Semibold" Margin="5,8,5,2" /><TextBlock Text="Floating · airy" Style="{StaticResource MutedText}" Margin="5,0,5,3" /></StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Tag="Meridian" AutomationProperties.Name="Meridian — framed, compact">
                                    <StackPanel><local:DockThemePreviewControl x:Name="MeridianPreview" DockTheme="Meridian" Height="94" IsHitTestVisible="False" /><TextBlock Text="Meridian" FontFamily="Segoe UI Semibold" Margin="5,8,5,2" /><TextBlock Text="Framed · compact" Style="{StaticResource MutedText}" Margin="5,0,5,3" /></StackPanel>
                                </ListBoxItem>
                            </ListBox>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Color palette" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ThemeComboBox" SelectionChanged="Appearance_SelectionChanged" AutomationProperties.Name="Color palette"><ComboBoxItem Content="Lunar — silver violet" Tag="LunarGlass" /><ComboBoxItem Content="Midnight — deep charcoal" Tag="Midnight" /><ComboBoxItem Content="Limestone — warm ivory" Tag="Limestone" /><ComboBoxItem Content="Aegean — marine blue" Tag="Aegean" /><ComboBoxItem Content="Follow Windows" Tag="System" /></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Dock bar size" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="DockBarSizeComboBox" SelectionChanged="Appearance_SelectionChanged" AutomationProperties.Name="Dock bar size" ToolTip="Scales dock names, icons and buttons together. Tabs stay below the name bar and hide when rolled up."><ComboBoxItem Content="Compact" Tag="Compact" /><ComboBoxItem Content="Standard" Tag="Standard" /><ComboBoxItem Content="Large" Tag="Large" /></ComboBox></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Application icon" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="IconStyleComboBox" SelectionChanged="IconStyle_SelectionChanged" AutomationProperties.Name="Application icon"><ComboBoxItem Content="Aperture — default" Tag="Aperture" /><ComboBoxItem Content="Selene — crescent" Tag="Selene" /><ComboBoxItem Content="Aster — star" Tag="Aster" /></ComboBox></StackPanel>
                            </Grid>
                            <Expander x:Name="CustomColorsExpander" Header="Customize colors" Style="{StaticResource OptionalAppearanceSection}" Margin="0,0,0,14" Foreground="{DynamicResource Pandora.TextBrush}">
                                <StackPanel Margin="0,12,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Accent · optional HEX" Style="{StaticResource FieldLabel}" /><DockPanel><Button DockPanel.Dock="Right" Content="Pick…" Tag="Accent" Click="PickCustomColor_Click" Margin="8,0,0,0" MinWidth="56" /><TextBox x:Name="CustomAccentTextBox" TextChanged="CustomColor_TextChanged" Margin="0" MaxLength="16" AutomationProperties.Name="Custom accent color in hex" /></DockPanel></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Surface · optional HEX" Style="{StaticResource FieldLabel}" /><DockPanel><Button DockPanel.Dock="Right" Content="Pick…" Tag="Surface" Click="PickCustomColor_Click" Margin="8,0,0,0" MinWidth="56" /><TextBox x:Name="CustomSurfaceTextBox" TextChanged="CustomColor_TextChanged" Margin="0" MaxLength="16" AutomationProperties.Name="Custom surface color in hex" /></DockPanel></StackPanel>
                                    </Grid>
                                    <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Use palette colors" Click="ResetCustomColors_Click" Margin="12,0,0,0" /><TextBlock Text="Use #RRGGBB or leave blank. Individual dock overrides stay unchanged." Style="{StaticResource MutedText}" VerticalAlignment="Center" /></DockPanel>
                                </StackPanel>
                            </Expander>
                            <TextBlock x:Name="AppearanceValidationText" TextWrapping="Wrap" Foreground="{DynamicResource Pandora.DangerBrush}" Margin="0,0,0,12" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><DockPanel><TextBlock x:Name="GlassOpacityText" DockPanel.Dock="Right" Text="88%" HorizontalAlignment="Right" /><TextBlock Text="Dock surface opacity" Style="{StaticResource FieldLabel}" /></DockPanel><Slider x:Name="GlassOpacitySlider" Minimum="55" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="GlassOpacitySlider_ValueChanged" AutomationProperties.Name="Dock surface opacity percent" ToolTip="Header and body backgrounds. Text and controls stay solid; individual dock overrides still apply." /></StackPanel>
                                <CheckBox x:Name="ReduceMotionCheckBox" Grid.Column="2" Content="Reduce motion" Click="AppearancePreference_Click" VerticalAlignment="Center" Margin="0" />
                            </Grid>
                            <TextBlock x:Name="AccessibilityText" Style="{StaticResource MutedText}" Text="Windows high contrast and reduced-animation preferences are always respected." Margin="0,0,0,18" />
                            <WrapPanel><Button x:Name="ApplyAppearanceButton" Content="Apply appearance" Style="{StaticResource Pandora.AccentButton}" Click="SaveAppearance_Click" Margin="0,0,8,8" /><Button Content="Revert preview" Click="RevertTheme_Click" /></WrapPanel>
                            <TextBlock Text="Preview is live. Apply to keep; closing restores your last saved appearance." Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <StackPanel x:Name="DesktopPanel" Visibility="Collapsed">
                            <TextBlock Text="Windows integration" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start Pandora with Windows" Click="StartWithWindows_Click" />
                            <TextBlock Text="This startup preference is saved immediately." Style="{StaticResource MutedText}" Margin="27,-4,0,18" />
                            <CheckBox x:Name="CleanDesktopCheckBox" Content="Hide Windows desktop icons while Pandora runs" />
                            <CheckBox x:Name="StayVisibleOnShowDesktopCheckBox" Content="Keep docks visible when showing the desktop" />
                            <CheckBox x:Name="AttachDesktopCheckBox" Content="Attach docks to the desktop shell" />
                            <TextBlock Text="Shell attachment is best-effort. Turn it off if your desktop or window manager behaves unexpectedly." Style="{StaticResource MutedText}" Margin="27,0,0,24" />
                            <Button Content="Apply desktop settings" Click="SaveDesktop_Click" Style="{StaticResource Pandora.AccentButton}" HorizontalAlignment="Left" />
                            <TextBlock Text="Workspace file" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Advanced edits can be made in the local JSON. Reload only after saving your file." Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                            <WrapPanel><Button Content="Open workspace JSON" Click="OpenWorkspace_Click" /><Button Content="Reload workspace" Click="Reload_Click" /></WrapPanel>
                        </StackPanel>
                        <StackPanel x:Name="DocksPanel" Visibility="Collapsed">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ListBox x:Name="ZonesList" DisplayMemberPath="Name" SelectionChanged="ZonesList_SelectionChanged" MaxHeight="146" Margin="0,0,16,18" BorderThickness="1" BorderBrush="{DynamicResource Pandora.BorderBrush}" AutomationProperties.Name="Select dock" />
                                <Button Grid.Column="1" Content="Add dock" Click="AddZone_Click" VerticalAlignment="Top" />
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Dock name" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NameTextBox" AutomationProperties.Name="Dock name" /><TextBlock Text="Background color" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BackgroundTextBox" AutomationProperties.Name="Dock background color" /><TextBlock Text="Accent color" Style="{StaticResource FieldLabel}" /><TextBox x:Name="AccentTextBox" AutomationProperties.Name="Dock accent color" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Primary folder" Style="{StaticResource FieldLabel}" /><TextBox x:Name="PathTextBox" AutomationProperties.Name="Dock primary folder" /><TextBlock Text="Opacity (0.10–1.00)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="OpacityTextBox" AutomationProperties.Name="Dock opacity" /><TextBlock Text="Item icon size (24–96)" Style="{StaticResource FieldLabel}" /><TextBox x:Name="IconSizeTextBox" AutomationProperties.Name="Dock item icon size" /></StackPanel>
                            </Grid>
                            <TextBlock Text="Header icon" Style="{StaticResource FieldLabel}" />
                            <Grid MaxWidth="560" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Image x:Name="DockIconPreview" Width="30" Height="30" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="DockHeaderIconComboBox" Grid.Column="1" MinWidth="190" SelectedIndex="0" SelectionChanged="DockHeaderIcon_SelectionChanged" AutomationProperties.Name="Selected dock header icon">
                                    <ComboBoxItem Tag="Pandora" Content="Pandora — application variant" /><ComboBoxItem Tag="Custom" Content="Custom local image" /><ComboBoxItem Tag="None" Content="No icon" />
                                </ComboBox>
                                <Button x:Name="BrowseDockIconButton" Grid.Column="2" Content="Choose image…" Click="BrowseDockIcon_Click" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox x:Name="DockHeaderIconPathTextBox" IsReadOnly="True" TextChanged="DockHeaderIconPath_TextChanged" AutomationProperties.Name="Selected dock custom icon path" Margin="0,6,0,0" />
                            <TextBlock x:Name="DockIconStatusText" Style="{StaticResource MutedText}" Margin="0,4,0,4" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="PNG, ICO or JPEG · up to 8 MiB / 2048 pixels per side. Save dock to apply; other docks and the application icon stay unchanged." Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                            <TextBlock Text="Expansion edge" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="ExpansionEdgeComboBox" MaxWidth="300" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="Dock expansion edge" />
                            <WrapPanel><CheckBox x:Name="VisibleCheckBox" Content="Visible" /><CheckBox x:Name="LockedCheckBox" Content="Locked" /><CheckBox x:Name="CollapsedCheckBox" Content="Rolled up" /></WrapPanel>
                            <WrapPanel Margin="0,10,0,0"><Button x:Name="SaveZoneButton" Content="Save dock" Click="SaveZone_Click" Style="{StaticResource Pandora.AccentButton}" Margin="0,0,8,8" /><Button x:Name="CenterZoneButton" Content="Center" Click="CenterZone_Click" /><Button x:Name="RestoreSizeButton" Content="Restore size" Click="RestoreDockSize_Click" /><Button x:Name="DuplicateZoneButton" Content="Duplicate" Click="DuplicateZone_Click" /><Button x:Name="DeleteZoneButton" Content="Remove dock" Click="DeleteZone_Click" Style="{StaticResource DangerButton}" /></WrapPanel>
                            <TextBlock Text="Removing a dock removes its metadata, not the files it displays. Original default colors follow the theme; custom values remain yours." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="LayoutsPanel" Visibility="Collapsed">
                            <TextBlock Text="Saved layout" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="LayoutsComboBox" DisplayMemberPath="Name" SelectionChanged="LayoutsComboBox_SelectionChanged" AutomationProperties.Name="Saved layout" />
                            <TextBlock Text="Layout name" Style="{StaticResource FieldLabel}" /><TextBox x:Name="LayoutNameTextBox" AutomationProperties.Name="Layout name" />
                            <WrapPanel><Button Content="Save current as…" Click="SaveLayout_Click" Style="{StaticResource Pandora.AccentButton}" Margin="0,0,8,8" /><Button Content="Switch layout" Click="SwitchLayout_Click" /><Button Content="Duplicate" Click="DuplicateLayout_Click" /><Button x:Name="DeleteLayoutButton" Content="Delete layout" Click="DeleteLayout_Click" Style="{StaticResource DangerButton}" /></WrapPanel>
                            <TextBlock Text="Display recovery" Style="{StaticResource SectionTitle}" /><TextBlock Text="If a monitor change left a dock oversized, repair bounds without resetting its content or appearance." Style="{StaticResource MutedText}" Margin="0,0,0,12" /><Button Content="Repair dock sizes" Click="RepairDockSizes_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel x:Name="AudioPanel" Visibility="Collapsed">
                            <CheckBox x:Name="SoundEffectsCheckBox" Content="Interface sound effects" /><CheckBox x:Name="MusicDockCheckBox" Content="Show music dock" />
                            <TextBlock Text="Sound effects volume (0.00–1.00)" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" /><TextBox x:Name="SoundEffectsVolumeTextBox" MaxWidth="240" HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="Sound effects volume" />
                            <TextBlock Text="Music folder" Style="{StaticResource FieldLabel}" /><TextBox x:Name="MusicFolderTextBox" AutomationProperties.Name="Music folder" />
                            <WrapPanel><Button Content="Apply audio settings" Click="SaveAudio_Click" Style="{StaticResource Pandora.AccentButton}" Margin="0,0,8,8" /><Button Content="Open music folder" Click="OpenMusicFolder_Click" /></WrapPanel>
                        </StackPanel>
                        <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                            <TextBlock Text="Pandora" FontSize="22" FontFamily="Segoe UI Semibold" /><TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="0,6,0,24" />
                            <TextBlock Text="Desktop organization and project awareness, on your device." TextWrapping="Wrap" FontSize="14" />
                            <TextBlock Text="Desktop docks, music, and project dashboards. Your settings and content stay local." Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                            <TextBlock Text="Projects and Metis" Style="{StaticResource SectionTitle}" /><TextBlock Text="Projects reads registered local dashboards. It does not approve work, verify evidence, or control agents. Directors retain authority over each plan." Style="{StaticResource MutedText}" />
                            <TextBlock Text="File safety" Style="{StaticResource SectionTitle}" /><TextBlock Text="Organization is virtual by default. Removing a dock or shortcut does not delete the source file unless you explicitly choose a delete-real-file action." Style="{StaticResource MutedText}" />
                            <TextBlock Text="MIT License" Style="{StaticResource SectionTitle}" /><Button Content="Open workspace location" Click="OpenWorkspaceFolder_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource Pandora.SurfaceBrush}" BorderBrush="{DynamicResource Pandora.BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="42" AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Column="1" Content="Done" Click="Close_Click" MinWidth="88" Margin="16,8,0,8" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
