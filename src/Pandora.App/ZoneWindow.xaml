<Window x:Class="Pandora.App.ZoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pandora.App"
        Title="Pandora Dock"
        Width="360"
        Height="300"
        MinWidth="230"
        MinHeight="1"
        Foreground="{DynamicResource Pandora.TextBrush}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Deactivated="Window_Deactivated"
        StateChanged="Window_StateChanged"
        LocationChanged="Window_PlacementChanged"
        SizeChanged="Window_PlacementChanged"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Border x:Name="Frame"
            Background="Transparent"
            BorderBrush="{Binding BorderBrush}"
            BorderThickness="{DynamicResource Pandora.FrameBorderThickness}"
            CornerRadius="{Binding CornerRadius}"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="{DynamicResource Pandora.ShadowBlur}" ShadowDepth="4" Opacity="{DynamicResource Pandora.ShadowOpacity}" Color="#000000" />
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopChromeRow" Height="{Binding HeaderHeight}" />
                <RowDefinition x:Name="TopNavigationRow" Height="0" />
                <RowDefinition x:Name="ContentRow" Height="*" />
                <RowDefinition x:Name="BottomNavigationRow" Height="0" />
                <RowDefinition x:Name="BottomChromeRow" Height="26" />
            </Grid.RowDefinitions>

            <Border x:Name="BodyChrome" Grid.Row="1" Grid.RowSpan="3" Background="{Binding BackgroundBrush}"
                    BorderBrush="{Binding BorderBrush}" IsHitTestVisible="False" />
            <Border x:Name="AccentRail" Grid.RowSpan="5" Width="0" HorizontalAlignment="Left"
                    Background="{Binding AccentBrush}" Panel.ZIndex="2" IsHitTestVisible="False" />

            <Border x:Name="HeaderBorder"
                    Grid.Row="0"
                    Background="{Binding HeaderBrush}"
                    CornerRadius="17,17,0,0"
                    SizeChanged="HeaderBorder_SizeChanged"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid x:Name="HeaderGrid" Margin="{DynamicResource Pandora.HeaderPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BrandTile" Width="30"
                            Height="30"
                            CornerRadius="10"
                            Background="{DynamicResource Pandora.HoverBrush}"
                            ToolTip="{Binding HeaderIconStatus}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <Image x:Name="HeaderIconImage" Source="{Binding BrandImage}"
                               Stretch="Uniform"
                               Width="{DynamicResource Pandora.HeaderBrandImageSize}"
                               Height="{DynamicResource Pandora.HeaderBrandImageSize}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    </Border>

                    <StackPanel x:Name="TitleStackPanel" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" ClipToBounds="True">
                        <StackPanel x:Name="DockTitlePanel">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           ToolTip="{Binding Name}"
                                           Foreground="{DynamicResource Pandora.TextBrush}"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="{DynamicResource Pandora.TitleFontSize}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border x:Name="AgentBadgeBorder" Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="7,1"
                                        CornerRadius="8"
                                        Background="{DynamicResource Pandora.AccentBrush}"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AgentFeedBadgeText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding AgentFeedBadgeText}"
                                               Foreground="{DynamicResource Pandora.AccentTextBrush}"
                                               FontFamily="Segoe UI Semibold"
                                               FontSize="10" />
                                </Border>
                            </Grid>
                        </StackPanel>
                        <TextBox x:Name="SearchBox"
                                 Visibility="Collapsed"
                                 Height="26"
                                 Margin="0,0,10,0"
                                 Padding="9,3"
                                 Background="{DynamicResource Pandora.SurfaceBrush}"
                                 Foreground="{DynamicResource Pandora.TextBrush}"
                                 BorderBrush="{DynamicResource Pandora.BorderBrush}"
                                 CaretBrush="{DynamicResource Pandora.TextBrush}"
                                 FontFamily="Segoe UI"
                                 FontSize="12"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" />
                    </StackPanel>

                    <Border x:Name="HeaderControlsChrome" Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel x:Name="HeaderButtons" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="MusicHeaderControls"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed"
                                    Margin="0,0,6,0">
                            <Button Style="{StaticResource DockHeaderButton}"
                                    Content="&#xE892;"
                                    ToolTip="Previous"
                                    Click="MusicPrevious_Click" />
                            <Button x:Name="MusicPlayPauseButton"
                                    Style="{StaticResource DockHeaderButton}"
                                    Content="{Binding PlayPauseGlyph}"
                                    ToolTip="Play or pause"
                                    Margin="6,0,0,0"
                                    Click="MusicPlayPause_Click" />
                            <Button Style="{StaticResource DockHeaderButton}"
                                    Content="&#xE893;"
                                    ToolTip="Next"
                                    Margin="6,0,0,0"
                                    Click="MusicNext_Click" />
                        </StackPanel>
                        <Button x:Name="SearchButton"
                                Style="{StaticResource DockHeaderButton}"
                                Content="&#xE721;"
                                ToolTip="Search this dock"
                                Click="Search_Click" />
                        <Button x:Name="MoreButton" Style="{StaticResource DockHeaderButton}"
                                Content="&#xE712;"
                                ToolTip="Dock actions"
                                Margin="6,0,0,0"
                                Click="More_Click" />
                        <Button x:Name="CollapseButton"
                                Style="{StaticResource DockHeaderButton}"
                                Content="&#xE96E;"
                                ToolTip="Roll up"
                                Margin="6,0,0,0"
                                Click="Collapse_Click" />
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="NavigationHost" Grid.Row="1" Visibility="Collapsed" UseLayoutRounding="True">
                <ScrollViewer x:Name="NavigationScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="MinHeight" Value="{DynamicResource Pandora.TabMinHeight}" />
                            <Style.Triggers>
                                <Trigger Property="ComputedHorizontalScrollBarVisibility" Value="Visible">
                                    <Setter Property="MinHeight" Value="{DynamicResource Pandora.TabOverflowHeight}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel x:Name="TabsPanel" Orientation="Horizontal" />
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="2" x:Name="ContentHost" Margin="{DynamicResource Pandora.ContentPadding}">
            <ContentControl x:Name="ProjectsHost" Visibility="Collapsed" Background="Transparent" />
            <ListBox
                     x:Name="ItemsList"
                     ItemsSource="{Binding Items}"
                     Background="Transparent"
                     BorderThickness="0"
                     AllowDrop="True"
                     SelectionMode="Single"
                     Focusable="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="ItemsList_MouseDoubleClick"
                     PreviewKeyDown="ItemsList_PreviewKeyDown"
                     PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ItemsList_PreviewMouseMove"
                     PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown"
                     DragOver="ItemsList_DragOver"
                     Drop="ItemsList_Drop">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" Margin="10,10,8,6" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="{Binding DataContext.ItemMargin, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Setter Property="Background" Value="{Binding DataContext.ItemSurfaceBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Setter Property="BorderBrush" Value="{Binding DataContext.ItemBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Setter Property="Foreground" Value="{Binding DataContext.ItemTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                            CornerRadius="{DynamicResource Pandora.ItemCornerRadius}"
                                            Padding="{DynamicResource Pandora.ItemPadding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Pandora.HoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Pandora.TextBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Pandora.SelectionBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Pandora.SelectionTextBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:FileItemViewModel}">
                        <Grid Width="{Binding DataContext.ItemWidth, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="LabelRow" Height="34" />
                            </Grid.RowDefinitions>
                            <Image x:Name="FileGlyph" Grid.ColumnSpan="2" Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   Source="{Binding Icon}"
                                   HorizontalAlignment="Center"
                                   SnapsToDevicePixels="True" />
                            <TextBlock x:Name="FileLabel" Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding DisplayName}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       LineHeight="13" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ThemeId, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Meridian">
                                <Setter TargetName="FileGlyph" Property="Grid.ColumnSpan" Value="1"/>
                                <Setter TargetName="FileGlyph" Property="Width" Value="26"/>
                                <Setter TargetName="FileGlyph" Property="Height" Value="26"/>
                                <Setter TargetName="FileGlyph" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="FileLabel" Property="Grid.Row" Value="0"/>
                                <Setter TargetName="FileLabel" Property="Grid.Column" Value="1"/>
                                <Setter TargetName="FileLabel" Property="Grid.ColumnSpan" Value="1"/>
                                <Setter TargetName="FileLabel" Property="Margin" Value="10,0,0,0"/>
                                <Setter TargetName="FileLabel" Property="VerticalAlignment" Value="Center"/>
                                <Setter TargetName="FileLabel" Property="TextAlignment" Value="Left"/>
                                <Setter TargetName="LabelRow" Property="Height" Value="0"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="OpenItem_Click" />
                        <MenuItem Header="Remove from Dock" Click="RemoveFromDock_Click" />
                        <MenuItem Header="Pin to Desktop" Click="PinToDesktop_Click" />
                        <MenuItem Header="Reveal in Explorer" Click="RevealItem_Click" />
                        <Separator />
                        <MenuItem Header="Move Real File to Recycle Bin..." Click="DeleteRealFile_Click" />
                        <Separator />
                        <MenuItem Header="Refresh" Click="Refresh_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <Grid x:Name="MusicPanel"
                  Background="Transparent"
                  SizeChanged="MusicPanel_SizeChanged"
                  Visibility="Collapsed"
                  Margin="14,8,14,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="MusicNowPlaying" Grid.ColumnSpan="2">
                        <TextBlock Text="{Binding NowPlayingText}"
                                   Foreground="{DynamicResource Pandora.TextBrush}"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="LOCAL LIBRARY"
                                   Foreground="{DynamicResource Pandora.MutedBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ComboBox Grid.Row="1" Grid.ColumnSpan="2"
                              x:Name="MusicPlaylistPicker"
                              HorizontalAlignment="Stretch" Margin="0,8,0,0"
                              ToolTip="Choose a playlist" AutomationProperties.Name="Playlist"
                              ItemsSource="{Binding MusicPlaylists}"
                              SelectedItem="{Binding SelectedMusicPlaylist, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Background="{DynamicResource Pandora.SurfaceBrush}"
                              Foreground="{DynamicResource Pandora.TextBrush}"
                              BorderBrush="{DynamicResource Pandora.BorderBrush}" />
                </Grid>

                <ListBox Grid.Row="1"
                         x:Name="MusicTracksList"
                         ItemsSource="{Binding MusicTracks}"
                         SelectedItem="{Binding SelectedMusicTrack, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Pandora.TextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         Margin="0,8,0,6"
                         MouseDoubleClick="MusicTracksList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="6,2" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MusicTrackViewModel}">
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="♪" VerticalAlignment="Center" Foreground="{DynamicResource Pandora.MutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Padding="2,1"
                                           Foreground="{DynamicResource Pandora.TextBrush}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ShuffleCheckBox"
                              Content="Shuffle"
                              Foreground="{DynamicResource Pandora.TextBrush}"
                              IsChecked="{Binding IsMusicShuffle, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              x:Name="RepeatComboBox"
                              Width="88"
                              ToolTip="Repeat mode" AutomationProperties.Name="Repeat mode"
                              Margin="6,0"
                              SelectionChanged="RepeatComboBox_SelectionChanged" />
                    <Slider Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            x:Name="MusicVolumeSlider" MinWidth="40"
                            ToolTip="Volume" AutomationProperties.Name="Volume"
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding MusicVolume, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                    <Grid x:Name="MusicUtilityRow" Grid.Row="2" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button HorizontalAlignment="Left"
                            Content="Music folder" Margin="0,6,0,0"
                            Padding="6,5" FontSize="11"
                            Background="Transparent"
                            Foreground="{DynamicResource Pandora.TextBrush}"
                            BorderBrush="{DynamicResource Pandora.BorderBrush}"
                            Click="OpenMusicFolder_Click" />
                    <Button Grid.Column="1" HorizontalAlignment="Right"
                            x:Name="MusicVisualizerButton" Content="Visualizer ↗"
                            ToolTip="Open Silk Current audio visualizer" Margin="0,6,0,0" Padding="6,5" FontSize="11"
                            Background="Transparent" Foreground="{DynamicResource Pandora.AccentBrush}"
                            Click="MusicVisualizer_Click" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="AgentFeedPanel"
                  Background="{DynamicResource Pandora.SurfaceBrush}"
                  Visibility="Collapsed"
                  Margin="14,12,14,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding AgentFeedTitle}"
                                   Foreground="{DynamicResource Pandora.TextBrush}"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="15"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Border Padding="7,2"
                                    CornerRadius="8"
                                    Background="{DynamicResource Pandora.HoverBrush}"
                                    BorderBrush="{DynamicResource Pandora.BorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding AgentFeedStatusText}"
                                           Foreground="{DynamicResource Pandora.TextBrush}"
                                           FontSize="10"
                                           FontFamily="Segoe UI Semibold" />
                            </Border>
                            <TextBlock Text="{Binding AgentFeedSourceLine}"
                                       Foreground="{DynamicResource Pandora.MutedBrush}"
                                       FontSize="11"
                                       Margin="8,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              x:Name="AgentFeedSelector"
                              Width="150"
                              ItemsSource="{Binding AgentFeeds}"
                              SelectedItem="{Binding SelectedAgentFeed, Mode=TwoWay}"
                              DisplayMemberPath="Title"
                              SelectionChanged="AgentFeedSelector_SelectionChanged" />
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,12,0,10"
                        Padding="11,9"
                        CornerRadius="8"
                        Background="{DynamicResource Pandora.ElevatedBrush}"
                        BorderBrush="{DynamicResource Pandora.BorderBrush}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding AgentFeedSummary}"
                               Foreground="{DynamicResource Pandora.TextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedAgentFeed.Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:AgentFeedSectionViewModel}">
                                <Border Margin="0,0,0,10"
                                        Padding="11,9"
                                        CornerRadius="8"
                                        Background="{DynamicResource Pandora.SurfaceBrush}"
                                        BorderBrush="{DynamicResource Pandora.BorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource Pandora.TextBrush}"
                                                   FontFamily="Segoe UI Semibold"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{DynamicResource Pandora.MutedBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                        <ItemsControl ItemsSource="{Binding ChecklistItems}" Margin="0,7,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:AgentFeedChecklistItemViewModel}">
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Foreground="{DynamicResource Pandora.TextBrush}"
                                                              Margin="0,0,0,7">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Text}"
                                                                       Foreground="{DynamicResource Pandora.TextBrush}"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Foreground="{DynamicResource Pandora.MutedBrush}"
                                                                       FontSize="10"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,7,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:AgentFeedTextItemViewModel}">
                                                    <StackPanel Margin="0,0,0,7">
                                                        <TextBlock Text="{Binding Text}"
                                                                   Foreground="{DynamicResource Pandora.TextBrush}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Foreground="{DynamicResource Pandora.MutedBrush}"
                                                                   FontSize="10"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            </Grid>

            <Border x:Name="StatusBorder" Grid.Row="4" Background="{DynamicResource Pandora.SurfaceBrush}" CornerRadius="0,0,17,17">
                <DockPanel Margin="12,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource Pandora.MutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
